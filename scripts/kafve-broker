#!/usr/bin/env bash
# --- CONFIG --------------------------------------------------------
source "./scripts/logger"
source "./scripts/kafve-commons"

set -o errexit
set -o errtrace
set -o nounset
set -o pipefail

# --- ERROR CONTROL --------------------------------------------------------

# @description Limpia y notifica fallos en el script.
# @param $1 string Número de línea donde ocurrió el error.
broker::catch_error() {
	local -r line_number="$1"
	local -r script_name="${BASH_SOURCE[1]:-$0}"

	logger::err "Error en ${script_name}:${line_number}"
	logger::err "Comando fallido: '${BASH_COMMAND}'"
}

trap 'broker::catch_error $LINENO' ERR

# --- FUNCTIONS -----------------------------------------------------------

# @description Punto de entrada principal para gestionar las acciones del broker de Kafka.
# @param $@ string Argumentos pasados al script (ej. init, start, stop -f, --force).
broker::main() {
	local force_flag=false

	for arg in "$@"; do
		case "${arg}" in
		-f | --force)
			force_flag=true
			break
			;;
		esac
	done

	case "${1:-}" in
	 "help" | "-h" | "--help" | "")
		broker::help
		;;
	"init")
		broker::init "${force_flag}"
		;;
	"start")
		broker::start "${force_flag}"
		;;
	"stop")
		broker::stop
		;;
	"status")
		broker::status
		;;
	"logs")
		broker::logs
		;;
	"topics")
		broker::topics
		;;
	*)
		return 0
		;;
	esac
}

# @description Inicializa y formatea el broker o cluster de Apache Kafka.
# @param $1 string Flag ("true" o "false") que indica si se debe forzar el formateo sobreescribiendo datos antiguos.
# @return 0 si tuvo éxito, 1 de lo contrario.
broker::init() {
	logger::run "Iniciando configuración del Broker..."

	local -r force_flag="$1"
	local cluster_id
	local log_dir

	### Verifica el estado del broker y lo detiene si está activo
	if broker::is_running; then
		logger::custom "INFO" "Broker detectado en ejecución. Deteniendo para reinicialización..."
		broker::stop
	fi

	### Busca el directorio de configuración para Kafka
	if [[ ! -f "$(kafve_commons::normalize_path "${KAFVE_KAFKA_CONFIG}")" ]]; then
		logger::err "No se encuentra el archivo de configuración en ${KAFVE_KAFKA_CONFIG}" >&2
		return 1
	fi

	### Toma el directorio de metadata del cluster de KAFVE_KAFKA_CONFIG (Por defecto un server.properties)
	log_dir=$(kafve_commons::normalize_path "$(grep "^log.dirs=" "${KAFVE_KAFKA_CONFIG}" | head -n 1 | cut -d'=' -f2)")

	### Verifica y crea si es necesario el directorio .data
	if [[ -d "${log_dir}" ]]; then
		if [[ "${force_flag}" == "true" ]]; then
			logger::custom "FORCE" "Limpiando datos existentes en: ${log_dir}"
			rm -rf "${log_dir}"
			mkdir -p "${log_dir}"
		else
			logger::err "El directorio ${log_dir} ya contiene datos." >&2
			logger::err "Usa --force si quieres borrar el cluster actual y crear uno nuevo." >&2
			return 1
		fi
	fi

	### Generación de Id de Cluster Kafka
	cluster_id=$($(kafve_commons::get_kafka_script "kafka-storage" "${KAFVE_KAFKA_DIR}") random-uuid)
	if [[ -z "${cluster_id}" ]]; then
		logger::err "No se pudo generar el Cluster ID" >&2
		return 1
	fi
	logger::ok "Cluster ID generado: ${cluster_id}"

	### Formateo del almacenamiento en modo standalone
	if broker::init_run "${cluster_id}"; then
		logger::ok "Almacenamiento formateado en modo standalone."
		logger::done "Configuración del Broker finalizada."
		return 0
	else
		logger::err "Se ha producido un error formateando el cluster" >&2
		return 1
	fi
}

# @description Ejecuta el comando interno de Kafka para formatear el almacenamiento.
# @param $1 string ID único del cluster generado para Kafka.
broker::init_run() {
	local -r cluster_id="$1"
	local script_path

	script_path=$(kafve_commons::get_kafka_script "kafka-storage" "${KAFVE_KAFKA_DIR}")
	"${script_path}" format \
		--standalone \
		-t "${cluster_id}" \
		-c "${KAFVE_KAFKA_CONFIG}"
}

# @description Arranca el proceso del broker de Kafka.
# @param $1 string Flag ("true" o "false") para forzar la inicialización si no existe el directorio de logs.
broker::start() {
	local -r force_flag="$1"
	local log_dir

	logger::run "Inicializando Broker..."

	### Comprueba si existe la carpeta para los logs, especificado en el server.properties
	log_dir=$(kafve_commons::normalize_path "$(grep "^log.dirs=" "${KAFVE_KAFKA_CONFIG}" | head -n 1 | cut -d'=' -f2)")
	if [[ ! -d "${log_dir}" || "${force_flag}" == "true" ]]; then
		broker::init "${force_flag}"
	fi

	### Comprueba si ya hay un broker inicializado
	if broker::is_running; then
		logger::custom "SKIP" "El Broker ya está en ejecución."
		return 0
	fi

	### Ejecuta el script de inicio del servidor Kafka en segundo plano
	broker::start_run

	### Espera unos segundos y verifica si el proceso se mantiene activo
	logger::custom "WAIT" "Verificando inicialización del proceso (esperando 2s)..."
	sleep 2
	if ! broker::is_running; then
		logger::err "El Broker no ha podido inicializarse correctamente" >&2
		return 1
	fi

	logger::done "Se ha inicializado el broker"
}

# @description Lanza el ejecutable de Kafka en segundo plano dependiendo del sistema operativo.
broker::start_run() {
	local script_path
	local broker_pid
	script_path=$(kafve_commons::get_kafka_script "kafka-server-start" "${KAFVE_KAFKA_DIR}")

	if [[ "${OS:-}" == "Windows" ]]; then
		nohup "${script_path}" "${KAFVE_KAFKA_CONFIG}" >/dev/null 2>&1 &
		broker_pid=$!
		logger::ok "Broker inicializado con el PID: ${broker_pid}"
	else
		"${script_path}" -daemon config/server.properties &
		broker_pid=$!
		logger::ok "Broker inicializado con el PID: ${broker_pid}"
	fi
}

# @description Detiene de forma ordenada (y forzada si es necesario) el proceso de Kafka.
broker::stop() {
	logger::run "Deteniendo Broker..."

	### Verifica si el broker esta levantado
	if ! broker::is_running; then
		logger::done "El broker de Kafka está levantado y corriendo correctamente."
		return 0
	fi

	### Verifica y apaga los consumidores
	./scripts/kafve-consumer stop --all

	### Señal de parada oficial del broker
	kafve_commons::get_kafka_script "kafka-server-stop" "${KAFVE_KAFKA_DIR}"
	logger::custom "TASK" "Enviada señal de parada oficial"

	logger::custom "WAIT" "Esperando finalización del proceso de parada del broker"
	sleep 3

	### Verificación de parada del broker
	if broker::is_running; then
		# Parada forzada del broker
		logger::custom "FORCE" "El proceso no cerró a tiempo, forzando..."
		pkill -15 -f "kafka.Kafka"
		logger::ok "Proceso finalizado por fuerza (SIGTERM)"
	else
		logger::ok "El script oficial cerró el Broker correctamente"
	fi

	logger::done "Procedimiento completado."
}

# @description Muestra una tabla por consola con el estado actual, PID y Cluster ID del Broker.
broker::status() {
	logger::run "Consultando estado del Broker..."

	if ! broker::is_running; then
		logger::err "El Broker no se encuentra activo." >&2
		return 1
	fi

	echo "------------------------------------------------------------------------------------"
	printf "| %-8s | %-6s | %-60s |\n" "PID" "ESTADO" "CLUSTER ID (UUID)"
	echo "------------------------------------------------------------------------------------"

	while read -r line; do
		broker::print_status_row "${line}"
	done < <(jcmd | grep "kafka.Kafka")

	echo "------------------------------------------------------------------------------------"

	logger::done "Consulta de estado finalizada."
}

# @description Procesa e imprime una fila de la tabla de estados para un proceso Kafka detectado.
# @param $1 string Línea cruda extraída del comando `jcmd` para el proceso de Kafka.
broker::print_status_row() {
	local -r line="$1"
	local label_pid label_time
	local label_cluster_id="Unknown"
	local log_dir process_uptime_seconds

	label_pid=$(echo "${line}" | awk '{print $1}')
	process_uptime_seconds=$(jcmd "${label_pid}" VM.uptime | tr '\n' ' ' | awk '{print $2}')
	label_time=$(date -u -d @"${process_uptime_seconds:-0}" +%T)
	log_dir=$(kafve_commons::normalize_path "$(grep "^log.dirs=" "${KAFVE_KAFKA_CONFIG}" | head -n 1 | cut -d'=' -f2)")

	if [[ -f "${log_dir}/meta.properties" ]]; then
		label_cluster_id=$(grep "cluster.id" "${log_dir}/meta.properties" | cut -d'=' -f2 | tr -d '\r')
	fi

	printf "| %-8s | %-6s | %-8s | %-52s |\n" "${label_pid}" "OK" "${label_time}" "${label_cluster_id}"
}

# @description Muestra el visor de logs (tail -f) en tiempo real para el archivo server.log de Kafka.
broker::logs() {
	logger::run "Abriendo visor de logs para broker en tiempo real..."

	local -r log_file="${KAFVE_KAFKA_DIR}/logs/server.log"

	### Comprueba si existe archivo de log
	if [[ ! -f "${log_file}" ]]; then
		logger::err "No se encuentra el archivo en: ${log_file}" >&2
		return 1
	fi

	### Comprueba si existen brokers activos
	if ! broker::is_running; then
		logger::err "El Broker no se encuentra activo." >&2
		return 1
	fi

	### info para salir
	logger::custom "INFO" "Presiona CTRL+C para salir."
	echo "--------------------------------------------------"

	### Entra al visor de logs del broker y maneja la interrupción limpia con el trap local
	trap 'echo ""; logger::done "Has salido del visor de logs del broker"; trap - INT; return 0' INT
	tail -f "${log_file}" || true

	### Limpiamos la trap al salir para no afectar al resto del script
	trap - INT
}

# @description Muestra por pantalla un listado con todos los tópicos creados en el broker.
# @return 0 si tuvo éxito, 1 si el broker está caído o falla la consulta.
broker::topics() {
	logger::run "Consultando listado de tópicos en el servidor..."

	### Comprobar que el broker está levantado y disponible
	if ! broker::is_running; then
		logger::err "El Broker no se encuentra activo. No se pueden listar los tópicos." >&2
		return 1
	fi

	echo "------------------------------------------------------------------------------------"
	echo " TÓPICOS ACTIVOS EN EL CLUSTER "
	echo "------------------------------------------------------------------------------------"

	# Ejecuta el listado filtrando posibles salidas vacías
	if ! broker::topics_run; then
		echo "------------------------------------------------------------------------------------"
		logger::err "Error al conectar con el servidor para obtener los tópicos." >&2
		return 1
	fi

	echo "------------------------------------------------------------------------------------"
	logger::done "Consulta de tópicos finalizada."
	return 0
}

# @description Ejecuta el comando interno de Kafka para listar los tópicos existentes.
broker::topics_run() {
	local script_path
	script_path=$(kafve_commons::get_kafka_script "kafka-topics" "${KAFVE_KAFKA_DIR:-.}")

	"${script_path}" \
		--bootstrap-server "${KAFVE_BROKER_CLIENT_URL}" \
		--list
}

# @description Verifica si el proceso de Kafka está activo mediante jcmd.
# @return 0 si se encuentra activo, 1 en caso contrario.
broker::is_running() {
	jcmd | grep -q "kafka.Kafka"
}

# @description Imprime el menú de ayuda con la descripción detallada de los comandos.
broker::help() {
	cat <<'EOF'
Broker (Gestión del nodo Kafka):
    Uso: ./kafve broker <acción> [opciones]

    Acciones:
        init [-f]       Inicializa el almacenamiento y genera el Cluster ID (KRaft).
        start           Levanta el broker en modo daemon (fondo).
        stop            Detiene el proceso de forma segura (Graceful shutdown).
        status          Muestra una tabla con los procesos y PIDs activos.
        logs            Muestra los logs del servidor en tiempo real (tail -f).
        help, -h        Muestra este panel de asistencia técnica.

    Descripción de Acciones:
        init    Prepara los directorios de datos. Si no se especifica el ID,
                genera uno aleatorio. Requiere "server.properties".
        start   Inicia el proceso. Si detecta que no hay metadatos de KRaft,
                ejecuta un "init" automático antes de arrancar.
        stop    Envía una señal SIGTERM. Si el proceso no responde tras 3s,
                escala a una parada forzada para evitar procesos zombis.

    Opciones:
        -f, --force     En "init": Borra el directorio definido en "log.dirs"
                        y reformatea el cluster desde cero (Peligro: Borra datos).

    Ejemplos:
        ./kafve broker init --force
        ./kafve broker status

EOF
}

# --- Main run -----------------------------------------------------------
broker::main "$@"
