#!/usr/bin/env bash
# --- CONFIG --------------------------------------------------------
source "./scripts/logger"
source "./scripts/kafve-commons"

set -o errexit
set -o errtrace
set -o nounset
set -o pipefail

# --- ERROR CONTROL --------------------------------------------------------

# @description Limpia archivos temporales y notifica fallos en el script.
# @param $1 string Número de línea donde ocurrió el error.
consumer::catch_error() {
	local -r line_number="$1"
	local -r script_name="${BASH_SOURCE[1]:-$0}"

	logger::err "Error en ${script_name}:${line_number}" >&2
	logger::err "Comando fallido: '${BASH_COMMAND}'" >&2

	exit 1
}

trap 'consumer::catch_error $LINENO' ERR

# --- VARS -------------------------------------------------------------------------------------------------------------
readonly KAFKA_CONSUMER_CLASS="org.apache.kafka.tools.consumer.ConsoleConsumer"

# --- FUNCTIONS --------------------------------------------------------------------------------------------------------

# @description Punto de entrada principal para gestionar las acciones de los consumidores de Kafka.
# @param $@ string Argumentos pasados al script (ej: start, stop, -t, --topic mi_topic).
consumer::main() {
	local action=""
	local topic="SOMETHING"
	local all=false

	### Procesado de argumentos
	while [[ $# -gt 0 ]]; do
		case "$1" in
		help | -h | --help | "")
			action="help"
			shift
			;;
		start)
			action="start"
			shift
			;;
		stop)
			action="stop"
			shift
			;;
		logs)
			action="logs"
			shift
			;;
		consume-next)
			action="consume-next"
			shift
			;;
		status)
			action="status"
			shift
			;;
		-t | --topic)
			topic="${2:-}"
			shift 2
			;;
		--all)
			all=true
			shift 1
			;;
		*)
			logger::custom "SKIP" "./kafve consumer <comando> [argumentos]"
			return 0
			;;
		esac
	done

	### Delegación de comandos
	case "${action}" in
	"help")
		consumer::help
		return 0
		;;
	"start")
		consumer::start "${topic}"
		;;
	"stop")
		if [[ "${all}" == true ]]; then
			consumer::stop_all
		else
			consumer::stop "${topic}"
		fi
		;;
	"logs")
		consumer::logs "${topic}"
		;;
	"consume-next")
		consumer::consume_next "${topic}"
		;;
	"status")
		consumer::status
		;;
	*)
		return 1
		;;
	esac
}

# @description Inicializa un consumidor de Kafka en segundo plano y redirige su salida a un archivo de log.
# @param $1 string Nombre del tópico a consumir.
consumer::start() {
	local topic="$1"
	local log_file="${KAFVE_LOG_DIR}/consumer-${topic}.log"
	local consumer_pid

	logger::run "Inicializando consumidor para el tópico: ${topic}"

	### Comprueba si ya se ha arrancado un consumer en el tópico
	if consumer::is_running "${topic}"; then
		logger::warn "Ya existe un consumer para el tópico: ${topic}"
		return 0
	fi

	### Comprueba si existe una carpeta de logs, sino la crea
	if [[ ! -d "${KAFVE_LOG_DIR}" ]]; then
		mkdir -p "${KAFVE_LOG_DIR}"
		logger::ok "Carpeta de logs '${KAFVE_LOG_DIR}' creada correctamente."
	fi

	### Comprueba si se ha quedado un consumer.log residual y lo elimina
	if [[ -f "${log_file}" ]]; then
		rm -f "${log_file}"
		logger::ok "Borrado archivo residual del anterior consumer del mismo tópico"
	fi

	### Inicializa el consumer delegando en la función secundaria
	consumer_pid=$(consumer::start_run "${topic}" "${log_file}")

	### Comprueba que se ha inicializado correctamente
	sleep 1
	if jcmd | grep "${consumer_pid} ${KAFKA_CONSUMER_CLASS}" >/dev/null; then
		logger::done "Consumidor del tópico '${topic}' iniciado en segundo plano."
		logger::done "Logs disponibles en: ${log_file} (PID: ${consumer_pid})"
		return 0
	else
		logger::err "El consumidor falló al arrancar. Revisa ${log_file} para más detalles."
		return 1
	fi
}

# @description Lanza el binario del consumidor de Kafka en segundo plano.
# @param $1 string Nombre del tópico.
# @param $2 string Ruta al archivo de log donde volcar la salida.
# @stdout string Devuelve el PID del proceso generado.
consumer::start_run() {
	local topic="$1"
	local log_file="$2"
	local script_path
	local consumer_pid

	script_path=$(kafve_commons::get_kafka_script "kafka-console-consumer" "${KAFVE_KAFKA_DIR:-.}")

	### Inicializa el consumer en segundo plano
	"${script_path}" \
		--consumer.config "${KAFVE_KAFKA_CONSUMER_CONFIG}" \
		--topic "${topic}" \
		--group "group-consumer-${topic}" \
		--from-beginning \
		--property print.key=true \
		--property key.separator=" | " \
		--bootstrap-server "${KAFVE_BROKER_CLIENT_URL}" \
		--consumer-property enable.auto.commit=false \
		>"${log_file}" 2>&1 &

	consumer_pid=$!

	echo "${consumer_pid}"
}

# @description Abre el visor de logs en tiempo real para un consumidor específico.
# @param $1 string Nombre del tópico.
consumer::logs() {
	local topic="$1"
	local log_file="${KAFVE_LOG_DIR}/consumer-${topic}.log"

	logger::run "Abriendo visor de logs para el consumer en tiempo real..."

	### Comprueba si existe el log para visualizar
	if [[ ! -f "${log_file}" ]]; then
		logger::err "No se ha encontrado el archivo de log: ${log_file}"
		return 1
	fi

	trap 'printf "\n"; logger::done "Has salido del visor de logs del consumer"; trap - INT; return' INT
	tail -f "${log_file}"

	### Limpiamos la trap al salir para no afectar al resto del script
	trap - INT
}

# @description Detiene de forma ordenada o forzada el consumidor asignado a un tópico.
# @param $1 string Nombre del tópico.
consumer::stop() {
	local topic="$1"
	local pid

	logger::run "Deteniendo consumidor del tópico '${topic}'"

	### Buscamos el pid del consumer para el tópico (Se quitó el redireccionamiento incorrecto del subshell)
	# shellcheck disable=SC2009
	if ! pid=$(jcmd | grep -e "--topic ${topic}" | grep "${KAFKA_CONSUMER_CLASS}" | awk '{print $1}'); then
		logger::err "No se encontró un consumer en ejecución para el tópico: ${topic}"
		return 0
	fi

	# Mata el proceso con el pid encontrado para ese tópico
	consumer::clean_topics_logs "${pid}"
	consumer::stop_pid_process "${pid}"
}

# @description Detiene todos los consumidores de forma ordenada o forzada.
# @return 0 tanto si detiene consumidores como si no encuentra ninguno activo.
consumer::stop_all() {
	local consumers_list
	local line pid

	logger::run "Deteniendo los consumidores"

	### Verificamos si la lista quedó vacía (-z)
	if ! consumers_list=$(jcmd | grep "${KAFKA_CONSUMER_CLASS}"); then
		logger::warn "No se encontró ningún consumidor activo en ejecución."
		logger::done "Proceso de parada finalizado sin cambios."
		return 0
	fi

	### Procesamos la lista línea por línea usando un "Here-string" (<<<)
	while read -r line; do
		pid=$(echo "${line}" | awk '{print $1}')
		consumer::clean_topics_logs "${pid}"
		consumer::stop_pid_process "${pid}"
	done <<<"${consumers_list}"

	logger::done "Se han detenido los consumidores"
}

# @description Detiene un proceso de forma ordenada (SIGTERM) con un tiempo de espera (timeout).
# Si el proceso no responde, fuerza su finalización utilizando una señal letal (SIGKILL).
# @param $1 int El Identificador de Proceso (PID) que se desea detener.
consumer::stop_pid_process() {
	local pid="$1"
	local timeout=5 # Corrección: En minúsculas por ser variable local interna

	### Verificamos que el PID no esta vacío y son solo valores númericos
	if [[ -z "${pid}" || ! "${pid}" =~ ^[0-9]+$ ]]; then
		logger::err "PID inválido: ${pid}"
		return 1
	fi

	### Comprobar si el proceso realmente existe antes de actuar
	if ! kill -0 "${pid}" 2>/dev/null; then
		logger::warn "El proceso con PID ${pid} no está en ejecución."
		return 0
	fi

	### Mata el proceso con el pid encontrado para ese pid
	kill -15 "${pid}"
	logger::ok "Enviando SIGTERM al proceso ${pid}..."

	### Verificamos si realmente murió
	while ((timeout > 0)); do
		if ! kill -0 "${pid}" 2>/dev/null; then
			logger::ok "El proceso ${pid} finalizó correctamente."
			return 0
		fi

		sleep 1
		timeout=$((timeout - 1))
	done

	### Verificamos si realmente murió
	logger::warn "El proceso no respondió a tiempo. Forzando parada con SIGKILL..."
	kill -9 "${pid}" 2>/dev/null

	### Confirmación final de la parada forzada
	sleep 0.5
	if ! kill -0 "${pid}" 2>/dev/null; then
		logger::done "Proceso ${pid} detenido por la fuerza."
		return 0
	else
		logger::err "No se pudo detener el proceso ${pid} incluso con SIGKILL."
		return 1
	fi
}

# @description Elimina el archivo de log como parte del proceso de parada y limpieza
# @param $1 pid del proceso del cual extraer el tópico
consumer::clean_topics_logs() {
	local pid="$1"
	local topic log_file

	### Validar que se ha pasado el PID requerido
	if [[ -z "${pid}" ]]; then
		logger::err "No se proporcionó el PID del proceso."
		return 1
	fi

	### Control estricto del directorio de logs
	if [[ -z "${KAFVE_LOG_DIR}" ]]; then
		logger::err "La variable de entorno KAFVE_LOG_DIR no está configurada."
		return 1
	fi

	### 3. Obtener el tópico de manera segura
	if ! topic=$(jcmd "${pid}" VM.command_line 2>/dev/null | grep -oP '(?<=--topic )\S+') ||
		[[ -z "${topic}" ]]; then
		logger::err "No se pudo obtener un tópico válido para el PID ${pid}."
		return 1
	fi

	### 4. Borrar el archivo de log de forma segura
	log_file="${KAFVE_LOG_DIR}/consumer-${topic}.log"
	if [[ -f "${log_file}" ]]; then
		rm -f "${log_file}"
		logger::ok "Borrado archivo de log del consumer para el tópico: ${topic}"
	else
		logger::warn "No se encontró el archivo de log: ${log_file}"
	fi
}

# @description Muestra por pantalla una tabla con todos los consumidores de Kafka activos.
consumer::status() {
	logger::run "Consultando estado de los Consumers..."

	if ! jcmd | grep -q "${KAFKA_CONSUMER_CLASS}"; then
		logger::err "No se encontraron Consumers activos."
		return 0
	fi

	echo "--------------------------------------------------------------------------------------------------------"
	printf "| %-8s | %-22s | %-10s | %-8s | %-40s |\n" "PID" "TOPIC" "OFFSET" "TIME" "BROKER URL"
	echo "--------------------------------------------------------------------------------------------------------"

	while read -r line; do
		consumer::print_status_row "${line}"
	done < <(jcmd | grep "${KAFKA_CONSUMER_CLASS}")
	echo "--------------------------------------------------------------------------------------------------------"

	logger::done "Consulta de estado finalizada."
}

# @description Procesa una línea de comando de proceso de consumidor y la imprime formateada en la tabla.
# @param $1 string Línea de salida de comando jcmd.
consumer::print_status_row() {
	local line="$1"
	local process_uptime_seconds script_path group_id
	local label_pid label_time label_topic label_broker_url label_offset

	label_pid=$(echo "${line}" | awk '{print $1}')
	process_uptime_seconds=$(jcmd "${label_pid}" VM.uptime 2>/dev/null | tr '\n' ' ' | awk '{print $2}')
	label_time=$(date -u -d @"${process_uptime_seconds:-0}" +%T)

	label_topic=$(echo "${line}" | awk -F'--topic ' '{print $2}' | awk '{print $1}')
	label_broker_url=$(echo "${line}" | awk -F'--bootstrap-server ' '{print $2}' | awk '{print $1}')

	script_path=$(kafve_commons::get_kafka_script "kafka-consumer-groups" "${KAFVE_KAFKA_DIR:-.}")
	group_id=$(jcmd "${label_pid}" VM.command_line 2>/dev/null | grep -oP '(?<=--group )\S+' || echo "")
	if [[ -n "${group_id}" ]]; then
		label_offset=$("${script_path}" --bootstrap-server "${KAFVE_BROKER_CLIENT_URL}" --describe --group "${group_id}" 2>/dev/null |
			grep "${label_topic}" | awk '{print $4}' | head -n 1)
	fi

	printf "| %-8s | %-22s | %-10s | %-8s | %-40s |\n" \
		"${label_pid}" "${label_topic}" "${label_offset:-0}" "${label_time}" "${label_broker_url}"
}

# @description Lee el siguiente mensaje pendiente del grupo, lo procesa/muestra y confirma su lectura.
# @param $1 string Nombre del tópico.
consumer::consume_next() {
	local -r topic="$1"
	local -r group_id="group-consumer-${topic}"
	local script_group script_consumer
	local current_offset next_offset message

	script_group=$(kafve_commons::get_kafka_script "kafka-consumer-groups" "${KAFVE_KAFKA_DIR:-.}")
	script_consumer=$(kafve_commons::get_kafka_script "kafka-console-consumer" "${KAFVE_KAFKA_DIR:-.}")

	### Comprueba si ya se ha arrancado un consumer en el tópico
	if consumer::is_running "${topic}"; then
		logger::warn "Ya existe un consumer para el tópico: ${topic}"
		return 0
	fi

	### Consultar a Kafka qué offset tiene pendiente este grupo (CURRENT-OFFSET)
	current_offset=$("${script_group}" --bootstrap-server "${KAFVE_BROKER_CLIENT_URL}" --describe --group "${group_id}" 2>/dev/null |
		grep "${topic}" | awk '{print $4}' | head -n 1 || echo "")

	### Si el grupo es nuevo, da vacío o devuelve el guion de Kafka '-', empezamos en el 0
	if [[ -z "${current_offset}" || "${current_offset}" == "-" || "${current_offset}" == "" ]]; then
		current_offset=0
	fi

	logger::run "Leyendo el siguiente mensaje disponible (Offset: ${current_offset})..."

	### Consumir exactamente el mensaje de ese offset
	message=$("${script_consumer}" \
		--bootstrap-server "${KAFVE_BROKER_CLIENT_URL}" \
		--topic "${topic}" \
		--partition 0 \
		--offset "${current_offset}" \
		--max-messages 1 \
		--timeout-ms 2000 2>/dev/null | grep -v "Processed a total of" || echo "")

	###Si no hay mensaje nuevo tras el timeout, indicamos que la cola está vacía
	if [[ -z "${message}" ]]; then
		logger::err "TIMEOUT: No hay mensajes en la cola del tópico '${topic}'."
		return 1
	fi

	echo "--------------------------------------------------------------------------------"
	logger::custom "MSG" "Procesando: ${message}"
	echo "--------------------------------------------------------------------------------"

	### Calcular el siguiente paso (+1) y hacer el commit manual en el Broker
	next_offset=$((current_offset + 1))

	### Quitamos la redirección silenciosa para ver el error real si el consumidor está activo
	if "${script_group}" \
		--bootstrap-server "${KAFVE_BROKER_CLIENT_URL}" \
		--group "${group_id}" \
		--topic "${topic}" \
		--reset-offsets \
		--to-offset "${next_offset}" \
		--execute >/dev/null; then

		logger::done "Commit realizado con éxito. Siguiente lectura apuntará al offset: ${next_offset}"
		return 0
	else
		logger::err "No se pudo confirmar el mensaje en Kafka."
		logger::err "REGLA: Debes ejecutar './kafve consumer stop -t ${topic}' antes de usar consume-next."
		return 1
	fi
}

# @description Comprueba si un consumidor específico de un tópico está activo en el sistema.
# @param $1 string Nombre del tópico.
# @return 0 si se está ejecutando, 1 en caso contrario.
consumer::is_running() {
	local topic="$1"

	jcmd | grep -e "--topic ${topic}" | grep -q "${KAFKA_CONSUMER_CLASS}"
}

# @description Imprime el menú de ayuda con la descripción detallada de los comandos.
consumer::help() {
  cat <<'EOF'
Consumer (Gestión de consumo de mensajes):
    Uso: ./kafve consumer <acción> [opciones]

    Acciones:
        start <-t tópico>    Inicia un consumidor para un tópico específico.
        stop <-t tópico>     Detiene un consumidor para un tópico específico.
        stop --all           Detiene todos los consumidores de forma masiva.
        logs <-t tópico>     Muestra los logs del consumidor en tiempo real.
        consume-next <-t top>Lee el siguiente mensaje atómico y hace commit manual.
        status               Lista todos los consumidores activos.
        help, -h             Muestra este panel de asistencia técnica.

    Descripción de Acciones:
        start         Inicializa un consumidor en segundo plano para el tópico indicado.
                      Crea logs en log/consumer-<tópico>.log y verifica que arranque correctamente.
        stop          Detiene el consumidor del tópico especificado, eliminando logs residuales.
        consume-next  Consulta el offset actual, extrae el siguiente mensaje único disponible
                      en la cola y confirma manualmente su lectura avanzando el puntero (+1).
        logs          Abre un visor en tiempo real de los logs del consumidor (tail -f).
        status        Muestra una tabla con PID, tópico, tiempo y URL del broker de consumidores activos.

    Opciones:
        -t, --topic     Nombre del tópico (Obligatorio para start, stop, logs y consume-next).
        --all           Aplica la acción de detención sobre todos los procesos activos.

    Ejemplos:
        ./kafve consumer start -t Example
        ./kafve consumer consume-next -t Example
        ./kafve consumer stop --all
        ./kafve consumer status

EOF
}

# --- MAIN RUN -----------------------------------------------------------
consumer::main "$@"
